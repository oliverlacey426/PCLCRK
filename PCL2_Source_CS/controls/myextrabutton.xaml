<?xml version="1.0" encoding="utf-8"?>
<Grid x:Class="PCL.MyExtraButton" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Name="PanBack" Width="40" RenderTransformOrigin="0.5,0.5" Height="0" xmlns:pcl="clr-namespace:PCL">
