    <UIElement.RenderTransform>
      <ScaleTransform />
    </UIElement.RenderTransform>
    <Border Name="PanColor" CornerRadius="1000" BorderThickness="0.001" Background="{DynamicResource ColorBrush3}">
      <UIElement.Effect>
        <DropShadowEffect ShadowDepth="0" BlurRadius="10" Opacity="0.2" />
