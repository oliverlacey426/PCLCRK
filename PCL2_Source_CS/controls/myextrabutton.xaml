        </RectangleGeometry>
      </UIElement.Clip>
      <!--Unknown connection ID: 5-->
    </Border>
    <Path Name="Path" Stretch="Uniform" Margin="12" Fill="{DynamicResource ColorBrush8}" RenderTransformOrigin="0.5,0.5">
      <UIElement.RenderTransform>
        <ScaleTransform />
      </UIElement.RenderTransform>
      <!--Unknown connection ID: 7-->
    </Path>
    <!--Unknown connection ID: 3-->
  </Grid>
  <!--Unknown connection ID: 1-->
</Grid>