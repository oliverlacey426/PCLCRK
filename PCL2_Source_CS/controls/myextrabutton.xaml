    <ScaleTransform ScaleX="0" ScaleY="0" />
  </UIElement.RenderTransform>
  <Border Name="PanClick" CornerRadius="1000" BorderThickness="0.001" Background="{StaticResource ColorBrushSemiTransparent}">
    <!--Unknown connection ID: 2-->
