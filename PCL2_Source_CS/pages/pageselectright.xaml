<?xml version="1.0" encoding="utf-8"?>
<local:MyPageRight x:Class="PCL.PageSelectRight" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" PanScroll="PanBack">
  <Grid>
    <Grid Name="PanAllBack">
      <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Name="PanMain" Margin="25,25,25,10" Grid.IsSharedSizeScope="True">
          <!--Unknown connection ID: 3-->
        </StackPanel>
        <!--Unknown connection ID: 2-->
      </local:MyScrollViewer>
      <local:MyCard x:Name="PanEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40" UseAnimation="False">
        <StackPanel Margin="20,17">
          <TextBlock Name="LabEmptyTitle" Margin="0,0,0,9" HorizontalAlignment="Center" Text="无可用版本" FontSize="19" UseLayoutRounding="True" SnapsToDevicePixels="True" Foreground="{DynamicResource ColorBrush3}">
            <!--Unknown connection ID: 5-->
          </TextBlock>
          <Rectangle HorizontalAlignment="Stretch" Height="2" Fill="{DynamicResource ColorBrush3}" />
          <TextBlock Name="LabEmptyContent" Margin="10,15,10,5" Text="未找到任何版本的游戏，请先下载任意版本的游戏。&#xA;若有已存在的游戏，请在左边的列表中选择“添加文件夹”，选择 .minecraft 文件夹将其导入。" TextWrapping="Wrap">
            <!--Unknown connection ID: 6-->
          </TextBlock>
          <local:MyButton x:Name="BtnEmptyDownload" Height="35" HorizontalAlignment="Center" MinWidth="140" Text="下载游戏" Margin="0,10,0,0" Padding="13,0" ColorType="Highlight">
            <!--Unknown connection ID: 7-->
          </local:MyButton>
        </StackPanel>
        <!--Unknown connection ID: 4-->
      </local:MyCard>
      <!--Unknown connection ID: 1-->
    </Grid>
    <local:MyCard x:Name="PanLoad" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" Margin="40">
      <local:MyLoading x:Name="Load" Text="正在获取版本列表" Margin="20,20,20,17" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" AutoRun="False">
        <!--Unknown connection ID: 9-->
      </local:MyLoading>
      <!--Unknown connection ID: 8-->
    </local:MyCard>
  </Grid>
</local:MyPageRight>